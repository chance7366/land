# 템플릿은 `.env.local.example` 을 사용하세요.
# (하위 호환을 위해 동일 내용을 유지합니다.)

DATA_PROVIDER=prisma

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

DATABASE_URL="file:./dev.db"
APP_BASE_URL=http://localhost:3000
ADMIN_EMAIL=admin@chance.local
ADMIN_PASSWORD=change-me-in-production
SESSION_SECRET=dev-session-secret-change-me
# 로컬 false / Production true (또는 Production+ADMIN_PASSWORD 시 자동 활성)
ADMIN_AUTH_ENABLED=false

GMAIL_USER=
GMAIL_APP_PASSWORD=
MAIL_FROM_NAME=찬스부동산
MAIL_REPLY_TO=

SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_SENDER_PHONE=
NOTIFY_KAKAO_ENABLED=false
SOLAPI_KAKAO_PF_ID=
SOLAPI_KAKAO_TEMPLATE_PROPERTY=
SOLAPI_KAKAO_TEMPLATE_AUCTION=

NEXT_PUBLIC_KAKAO_MAP_KEY=
NEXT_PUBLIC_NAVER_MAP_CLIENT_ID=

# 매물 등록 대장 조회 (건축물대장·토지특성)
PUBLIC_DATA_SERVICE_KEY=
# MOLIT_SERVICE_KEY=  # 별칭 — 공공데이터포털 키와 동일해도 됨
VWORLD_API_KEY=

# Vercel 법원 불러오기용 Chromium pack (기본: Sparticuz v149 x64)
# CHROMIUM_PACK_URL=https://github.com/Sparticuz/chromium/releases/download/v149.0.0/chromium-v149.0.0-pack.x64.tar

# 법령전문상담 (국가법령정보센터 OC). LAW_OC 별칭도 지원
LAW_OPEN_API_OC=
# LAW_OC=
